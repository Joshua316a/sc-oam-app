# Environment variables for sc-oam-app
# See https://github.com/organization/sc-oam-app for details

# Application
APP_NAME="sc-oam-app"
APP_VERSION="0.1.0"
DEBUG=True

# Database
DATABASE_URL="sqlite:///./database.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/sc_oam_db"

# Security
SECRET_KEY="change-this-to-a-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
